PORT=4173
REFRESH_INTERVAL_MINUTES=30
ADMIN_PASSWORD=change-this-admin-password
WECOM_BOT_WEBHOOK=
PUBLIC_DAILY_URL=http://localhost:4173/daily.html

# X: official trends API.
# Default is free public Trends24 collection. Use X_SOURCE=api only if you intentionally want the official paid X API.
X_SOURCE=trends24
X_TRENDS24_REGION=united-states
X_BEARER_TOKEN=
X_WOEID=1

# Weibo: try the public hot-search page. Add a valid cookie if Weibo returns the visitor system.
# Options: free-api, official, official-first.
WEIBO_SOURCE=official-first
WEIBO_FREE_API_URL=https://api.52vmy.cn/api/wl/hot?type=weibo
WEIBO_COOKIE=

# TikTok: default is the public Creative Center hashtag page. Use custom-json for a provider/own collector.
TIKTOK_SOURCE=creative-center
TIKTOK_CREATIVE_CENTER_COUNTRY=US
TIKTOK_CREATIVE_CENTER_PERIOD=7
# Supported shapes: an array, or { "data" | "trends" | "items" | "results" | "hashtags": [...] }.
TIKTOK_TRENDS_URL=
TIKTOK_TRENDS_BEARER_TOKEN=
TIKTOK_TRENDS_API_KEY=
TIKTOK_TRENDS_API_KEY_HEADER=X-API-Key

# Reddit: public JSON feed. proxy-first works in networks where reddit.com is blocked.
REDDIT_SUBREDDIT=popular
REDDIT_SORT=hot
REDDIT_LIMIT=30
REDDIT_SOURCE=proxy-first
REDDIT_PROXY_URL=

# Domestic gaming media through RSSHub.
GAMERSKY_RSS_URL=https://rsshub.rssforever.com/gamersky/news
THREEDM_RSS_URL=https://rsshub.rssforever.com/3dmgame/news
YYSTV_RSS_URL=https://www.yystv.cn/rss/feed
GCORES_RSS_URL=https://rsshub.rssforever.com/gcores/news
BILIBILI_DAILY_RSS_URL=https://rsshub.rssforever.com/bilibili/ranking/all/0/3
BILIBILI_WEEKLY_RSS_URL=https://rsshub.rssforever.com/bilibili/weekly
GAMERES_JSON_URL=https://www.gameres.com/newslistJson
NADIANSHI_RSS_URL=http://www.nadianshi.com/feed
GAMELOOK_RSS_URL=http://www.gamelook.com.cn/feed

# Douban nowplaying. Use all to merge major cities, or set comma-separated city slugs.
DOUBAN_NOWPLAYING_CITIES=all
